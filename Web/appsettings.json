{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SecuritySettings": {
    "LogoutPath": "/logout",
    "LoginPath": "/login",
    "LoginDays": 60,
    "BanDurationHours": 24,
    "MaxOtpAttemptsPerDay": 3,
    "MaxCheckOtpAttemptsPerSend": 10,
    "OtpExpiryMinutes": 2
  }
}
