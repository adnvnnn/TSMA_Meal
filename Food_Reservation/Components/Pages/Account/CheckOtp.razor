@inject IStringLocalizer<Login> Localizer
@inject NavigationManager Navigation
@inject IJSRuntime Js

@using System.Timers
@using TSMA_Meal.ConfigModels
@using TSMA_Meal.Features.Account

<div class="otp-section active">

    <label class="form-label mb-3 d-block text-dark">
        @Localizer["Code"].Value
    </label>

    <div class="input-group mb-4">
        <input type="number" class="form-control text-center fw-bold fs-4" 
               @bind="_code" maxlength="6" >

    </div>

    @if (_errorMessage != null)
    {
        <div class="alert alert-danger mb-4 p-2" role="alert">
            @_errorMessage
        </div>
    }

    @if (_isCheckProcessing)
    {
        <button class="btn-main mb-3" >
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        </button>
    }
    else
    {
        <button class="btn-main mb-3" @onclick="CheckOtpAsync">
            @Localizer["Enter"].Value
        </button>
    }

    <div class="d-grid gap-2">
        @if (_resendCooldown > 0)
        {
            <button class="btn btn-light mb-2" >
                @string.Format(Localizer["CanResendIn"], _resendCooldown)
            </button>
        }
        else
        {
            <button class="btn-secondary mb-2" @onclick="ResendCodeAsync">
                @if (_isResendProcessing)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                }
                else
                {
                    <span>@Localizer["ResendCode"].Value</span>
                }
            </button>
        }

        <button class="btn-secondary" @onclick="HandleChangePhoneNumber">
            @Localizer["ChangeNumber"].Value
        </button>
    </div>

    <hr/>
    <small class="text-muted d-block text-center">@Localizer["PhoneNumber"].Value : @PhoneNumber</small>
</div>

<script src="js/login.js"></script>


@code {
    [Parameter, EditorRequired] public EventCallback ChangePhoneNumber { get; set; }
    [Parameter, EditorRequired] public string PhoneNumber { get; set; } = "";
    private string _code = "";

    private bool _isAnyProcessing = false;
    private bool _isCheckProcessing = false;
    private bool _isResendProcessing = false;
    private string? _errorMessage = null;

    protected override void OnInitialized()
    {
        StartTimer();
    }

    private async Task CheckOtpAsync()
    {
        if (string.IsNullOrWhiteSpace(_code)) return;

        _isAnyProcessing = true;

        _isCheckProcessing = true;

        _errorMessage = null;

        try
        {
            var error = await Js.InvokeAsync<string>("loginWithOtp", PhoneNumber, _code);

            if (!string.IsNullOrEmpty(error))
            {
                _errorMessage = error;
            }

        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }

        _isAnyProcessing = false;

        _isCheckProcessing = false;

    }

    private async Task HandleChangePhoneNumber()
    {
        _isAnyProcessing = true;

        _errorMessage = null;

        await ChangePhoneNumber.InvokeAsync();

        _isAnyProcessing = false;
    }

    private async Task ResendCodeAsync()
    {
        _isAnyProcessing = true;

        _isResendProcessing = true;

        _errorMessage = null;

        try
        {
            await Mediator.Send(new SendOtpRequest(PhoneNumber));

            StartTimer();

        }
        catch (Exception e)
        {
            _errorMessage = e.Message;
        }

        _isAnyProcessing = false;

        _isResendProcessing = false;
    }

}

@code
{
    private int _resendCooldown;

    private Timer? _timer;

    private void StartTimer()
    {
        _resendCooldown = SecuritySettingsConfigModel.OtpExpiryMinutes * 60;
        _timer?.Dispose();
        _timer = new Timer(1000);
        _timer.Elapsed += (sender, e) =>
        {
            if (_resendCooldown > 0)
            {
                _resendCooldown--;
                InvokeAsync(StateHasChanged);
            }
            else
            {
                _timer.Stop();
            }
        };
        _timer.Start();
    }


    public void Dispose()
    {
        _timer?.Dispose();
    }
}
