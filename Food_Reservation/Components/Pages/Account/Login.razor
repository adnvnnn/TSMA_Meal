@page "/login"
@layout AccountLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="login-box">

    <Logo></Logo>

    @if (!_isCodeSent)
    {
        <SendOtp OnHandle="OnHandleSend"></SendOtp>
    }
    else
    {
        <CheckOtp ChangePhoneNumber="OnHandleChangePhone" PhoneNumber="@_phoneNumber"></CheckOtp>
    }

</div>

@code
{
    private bool _isCodeSent;
    private string? _phoneNumber;

    private async Task OnHandleSend(string? phoneNumber)
    {
        if (phoneNumber != null)
        {
            _isCodeSent = true;

            _phoneNumber = phoneNumber;
        }
        else
        {
            _isCodeSent = false;
        }

        await InvokeAsync(StateHasChanged);
    }


    private void OnHandleChangePhone()
    {
        _isCodeSent = false;
    }
}
