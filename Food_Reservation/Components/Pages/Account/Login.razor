@page "/login"
@using TSMA_Meal.Features.Account
@layout AccountLayout

@inject IStringLocalizer<Login> Localizer

<div class="login-box">
    <div class="text-center mb-4">
        <div class="logo">
            <img alt="" src="images/tsma-origin.webp" class="w-100" />
        </div>
        <h4 class="mb-2 fw-bold text-dark">@Localizer["PersonnelPortal"].Value</h4>
        <p class="text-muted mb-0">
            @Localizer["TsmaCompany"].Value
        </p>
    </div>

    @if (!_codeSent)
    {
        <div class="phone-section active">
            <label class="form-label mb-3 d-block text-dark">
                @Localizer["PhoneNumber"].Value
            </label>
            <div class="input-group mb-4">
                <input type="tel" class="form-control" placeholder="09123456789" @bind="_phoneNumber" maxlength="11">
            </div>
            <button class="btn-main mb-3" @onclick="() => SendOtpAsync()">
                @Localizer["SendCode"].Value
            </button>
            <hr />

            <small class="text-muted d-block text-center">
                @Localizer["Example"].Value
            </small>
        </div>
    }
    else
    {
        <div class="otp-section active">
            <label class="form-label mb-3 d-block text-dark">
                @Localizer["Code"].Value
            </label>
            <div class="input-group mb-4">
                <input type="text" class="form-control text-center fw-bold" id="otpInput" maxlength="6">
            </div>
            <button class="btn-main mb-3" @onclick="() => CheckOtpAsync()">
                @Localizer["Enter"].Value
            </button>
            <button class="btn-secondary" @onclick="() => _codeSent = false">
                @Localizer["ChangeNumber"].Value
            </button>

            <hr />
            <small class="text-muted d-block text-center">
                @_phoneNumber
            </small>
        </div>
    }



</div>

@code
{
    private string _phoneNumber = "09146271035";
    private string _code;
    private bool _codeSent = false;

    private async Task SendOtpAsync()
    {
        try
        {
            await Mediator.Send(new SendOtpRequest(_phoneNumber));

            _codeSent = true;

        }
        catch (PersonnelNotExistException e)
        {
            //TODO: Only Personnel can

            _codeSent = false;
        }

    }

    private async Task<bool> CheckOtpAsync()
    {

        return true;
    }
}
