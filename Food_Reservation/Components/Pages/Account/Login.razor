@page "/login"

@using TSMA_Meal.Features.Account
@layout AccountLayout


<div class="login-box">

    <Logo></Logo>

    @if (!_codeSent)
    {
        <SendOtp PhoneNumber="_phoneNumber"></SendOtp>
    }
    else
    {
        <CheckOtp Code="_code" PhoneNumber="_phoneNumber"></CheckOtp>
    }

</div>

@code
{

    private string _phoneNumber = "09146271035";
    private string _code = "123456";
    private bool _codeSent = false;


}
