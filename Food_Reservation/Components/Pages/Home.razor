@page "/"
@using Microsoft.AspNetCore.WebUtilities
@inject IStringLocalizer<Home> Localizer
@inject NavigationManager Navigation
@attribute [Authorize]

<div class="container">

    <div class="header-box text-center ">
        <h2 class="fw-bold text-dark mb-3">
            @Localizer["FoodMenu"].Value

            <span class="badge bg-danger ms-2">@_currentWeek</span>
        </h2>
        <p class="text-muted mb-3">
            @Localizer["SelectFood"].Value
        </p>
    </div>


    @if (Meals.Any())
    {
        <div class="row g-4">
            @foreach (var food in Meals)
            {

                var status = food.IsExpired || !food.IsAvailable ? "expired" : (food.IsReserved ? "reserved" : "available");


                <div class="col-lg-4 col-md-6">
                    <div class="card food-card position-relative  @status  h-100">
                        <div class="status-dot"></div>

                        <img src="@food.ImageUrl" class="food-img" alt="@food.Name">

                        <div class="card-body p-4">

                            <div class="d-flex mb-3">

                                <h5 class="fw-bold mb-0 text-center">@food.Name</h5>

                                @if (food.IsExpired)
                                {
                                    @if (food.IsReserved)
                                    {
                                        <small style="background-color: #28a745;"
                                               class="rounded-3 text-white fw-bold p-1 me-2">
                                            @Localizer["HasBeenReserved"].Value
                                        </small>
                                    }
                                    else
                                    {
                                        <small style="background-color: var(--primary-red);"
                                               class="rounded-3 text-white fw-bold p-1 me-2">
                                            @Localizer["HasBeenNotReserved"].Value
                                        </small>
                                    }
                                }
                            </div>


                            <div class="mb-3">
                                <span class="badge bg-light text-dark small">@food.Restaurant</span>
                            </div>

                            <div class="text-muted small mb-3">@food.Day - @food.Date</div>

                            <div class="mb-4">
                                <span class="h5 text-muted text-decoration-line-through mx-2">
                                    @PriceFormat.FormatNumber(food.Price)
                                </span>
                                <span class="h5 text-danger fw-bold">
                                    @food.DiscountedPrice.ToString("N0") @Localizer["Rial"].Value
                                </span>
                            </div>


                            <div class="justify-content-center">

                                @if (food.IsLoading)
                                {
                                    <button class="btn-food mb-2 " @onclick="() => ReserveAsync(food)" disabled="">
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    </button>

                                }
                                else
                                {
                                    <button class="btn-food mb-2 " @onclick="() => ReserveAsync(food)">

                                        @if (food.IsExpired)
                                        {
                                            <text>@Localizer["Expired"].Value</text>

                                        }
                                        else
                                        {
                                            @if (!food.IsAvailable)
                                            {
                                                <text>@Localizer["UnAvailable"].Value</text>

                                            }
                                            else
                                            {
                                                if (food.IsReserved)
                                                {
                                                    <text>
                                                        @Localizer["Reserved"].Value

                                                        <small class="fw-light text-opacity-25">@Localizer["ClickToCancel"]</small>
                                                    </text>

                                                }
                                                else
                                                {
                                                    <text>@Localizer["Reserve"].Value</text>

                                                }
                                            }
                                        }
                                    </button>

                                }



                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>



        <div class="row justify-content-center">
            <nav>
                <ul class="pagination custom-pagination p-0">
                    <li class="page-item @(_pageId == -1 ? "active" : "")">
                        <button class="page-link " @onclick="() => ChangePage(-1)">@Localizer["Prev"].Value</button>
                    </li>
                    <li class="page-item @(_pageId == 0 ? "active" : "")">
                        <button class="page-link " @onclick="() => ChangePage(0)">@Localizer["Current"].Value</button>
                    </li>

                    <li class="page-item @(_pageId == 1 ? "active" : "")">
                        <button class="page-link " @onclick="() => ChangePage(1)">@Localizer["Next"].Value</button>
                    </li>
                </ul>
            </nav>
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-items-center justify-content-start min-vh-100">
            <span class="spinner-border spinner-border-sm mb-3" style="width: 3rem; height: 3rem;"></span>
            <p>@Localizer["Loading"].Value</p>
        </div>
    }


</div>


@code
{
    private readonly int _userId = 436;
    private int _pageId;
    private bool _isProcessing = false;
    private string _currentWeek = "";

    public List<MealsViewModel> Meals { get; set; } = new();

    private async Task ChangePage(int pageId)
    {
        _pageId = pageId;

        Navigation.NavigateTo($"?week={pageId}", false);

        await LoadAsync(_pageId);

        _currentWeek = pageId switch
        {
            0 => Localizer["Current"].Value,
            1 => Localizer["Next"].Value,
            -1 => Localizer["Prev"].Value,
            _ => _currentWeek
        };
    }


    private async Task LoadAsync(int pageId = 0)
    {
        try
        {
            Meals = await Mediator.Send(new MealsListRequest(_userId, pageId));
            _currentWeek = Localizer["Current"].Value;
        }
        catch (PersonnelFiredException e)
        {
            //TODO:Log Out

            Navigation.NavigateTo("/login", forceLoad: true);

        }
        catch (NotPermittedException e)
        {
            //TODO:Log Out

            Navigation.NavigateTo("/login", forceLoad: true);

        }

    }
    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("week", out var page))
        {
            int.TryParse(page, out _pageId);
        }
        else
        {
            _pageId = 0;
        }

        await LoadAsync(_pageId);

        _currentWeek = _pageId switch
        {
            0 => Localizer["Current"].Value,
            1 => Localizer["Next"].Value,
            -1 => Localizer["Prev"].Value,
            _ => Localizer["Current"].Value
        };
    }



    private async Task ReserveAsync(MealsViewModel food)
    {
        if (_isProcessing) return;

        _isProcessing = true;

        food.IsLoading = true;

        @if (food is { IsExpired: false, IsAvailable: true })
        {
            if (food.IsReserved)
            {

                try
                {
                    await Mediator.Send(new CancelReserveRequest(food.ReserveId, _userId));

                    food.IsReserved = false;

                    _canceledMeal = food;

                    _showCanceledModal = true;
                }
                catch (Exception e)
                {
                    _showErrorModal = true;

                    food.IsReserved = true;
                }
            }
            else
            {
                try
                {
                    await Mediator.Send(new ReserveFoodRequest(food.Id, _userId, _pageId));

                    food.IsReserved = true;

                    _reservedMeal = food;

                    _showReservedModal = true;
                }
                catch (Exception e)
                {
                    _showErrorModal = true;

                    food.IsReserved = false;
                }
            }
        }

        food.IsLoading = false;
        _isProcessing = false;

    }
}



<ReservedModal OnClose="HandleReservedModelClose" Meal="_reservedMeal" ShowSucceed="_showReservedModal"></ReservedModal>

<CanceledModal OnClose="HandleCanceledModelClose" Meal="_canceledMeal" ShowSucceed="_showCanceledModal"></CanceledModal>

<ErrorModal OnClose="HandleErrorModelClose" Message="@Localizer["ActionNotHappend"].Value" Show="_showErrorModal"></ErrorModal>


@code {

    private bool _showReservedModal = false;
    private MealsViewModel? _reservedMeal = new();


    private void HandleReservedModelClose()
    {
        _showReservedModal = false;
        _reservedMeal = null;

    }


    private bool _showCanceledModal = false;
    private MealsViewModel? _canceledMeal = new();

    private void HandleCanceledModelClose()
    {
        _showCanceledModal = false;
        _canceledMeal = null;

    }


    private bool _showErrorModal = false;
    private void HandleErrorModelClose()
    {
        _showErrorModal = false;

    }
}