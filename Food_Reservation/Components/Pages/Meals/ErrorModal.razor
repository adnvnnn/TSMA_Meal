@if (Show)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
                <div class="modal-header border-0 text-white" style="border-radius: 15px 15px 0 0;background-color: #db3545;">
                    <h5 class="modal-title w-100 text-center">خطا در انجام رزرو</h5>
                </div>
                <div class="modal-body text-center p-4">

                    <p class="mb-0 mt-3">@Message</p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" @onclick="CloseModal" class="btn-food available shadow-none w-auto px-5" @onclick="CloseModal">تلاش مجدد</button>
                </div>
            </div>
        </div>
    </div>
}

@code {

    [Parameter, EditorRequired] public string Message { get; set; }

    [Parameter, EditorRequired] public bool Show { get; set; } = false;
    private async Task CloseModal()
    {
        Show = false;
        await OnClose.InvokeAsync();
    }

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

}