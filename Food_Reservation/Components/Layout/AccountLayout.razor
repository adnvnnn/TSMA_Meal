@inherits LayoutComponentBase

@Body

<form id="otp-form" method="post" action="/check-otp" style="display:none">
    <input name="phoneNumber" id="otp-phone" />
    <input name="code" id="otp-code" />
</form>

<script>
    window.submitOtpForm = function (phone, code) {
        document.getElementById('otp-phone').value = phone;
        document.getElementById('otp-code').value = code;
        document.getElementById('otp-form').submit();
    }
</script>