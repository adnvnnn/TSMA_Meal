@inject IStringLocalizer<Home> Localizer
@page "/"
@using Food_Reservation.Database
@using Food_Reservation.Entities
@using Microsoft.EntityFrameworkCore
@* @attribute [Authorize]
 *@
<div class="container">
    <div class="header-box text-center">
        <h2 class="fw-bold text-dark mb-3">
            @Localizer["FoodMenu"].Value

            <span class="badge bg-danger ms-2">به‌روز</span>
        </h2>
        <p class="text-muted mb-3">
            @Localizer["SelectFood"].Value
        </p>
    </div>

    <div class="row g-4" id="foodList"></div>
</div>

<script>

    const foods = [
        { id: 1, name: 'جوجه کباب', price: '45,000 تومان', img: '', rest: 'رستوران نایب', day: 'شنبه ۱۴۰۳/۰۱/۱۹' },
        { id: 2, name: 'زرشک پلو', price: '38,000 تومان', img: '', rest: 'رستوران مادر', day: 'یکشنبه ۱۴۰۳/۰۱/۲۰' },
        { id: 3, name: 'کباب کوبیده', price: '42,000 تومان', img: '', rest: 'رستوران تهران', day: 'دوشنبه ۱۴۰۳/۰۱/۲۱' },
        { id: 4, name: 'قورمه سبزی', price: '35,000 تومان', img: '', rest: 'رستوران سنتی', day: 'سه‌شنبه ۱۴۰۳/۰۱/۲۲' },
        { id: 5, name: 'چلو ماهیچه', price: '48,000 تومان', img: '', rest: 'رستوران نایب', day: 'چهارشنبه ۱۴۰۳/۰۱/۲۳' },
        { id: 6, name: 'ماکارونی', price: '32,000 تومان', img: '', rest: 'رستوران ایتالیایی', day: 'پنج‌شنبه ۱۴۰۳/۰۱/۲۴' }
    ];

    let reservations = JSON.parse(localStorage.getItem('res') || '[]');

    function render() {
        document.getElementById('foodList').innerHTML = foods.map(f => {
            const res = reservations.includes(f.id);
            return `
            <div class="col-lg-4 col-md-6">
                <div class="card food-card position-relative ${res ? 'reserved' : 'available'} h-100">
                    <div class="status-dot"></div>
                    <img src="${f.img}" class="food-img" alt="${f.name}">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-2">${f.name}</h5>
                        <div class="mb-3">
                            <span class="badge bg-light text-dark small">${f.rest}</span>
                        </div>
                        <div class="text-muted small mb-3">${f.day}</div>
                        <div class="h5 text-danger fw-bold mb-4">${f.price}</div>
                        <button class="btn-reserve ${res ? 'btn-reserved' : 'btn-available'}"
                                ${res ? 'disabled' : ''} onclick="toggle(${f.id})">
                            ${res ? '✅ رزرو شده' : '➕ رزرو کنید'}
                        </button>
                    </div>
                </div>
            </div>`;
        }).join('');
    }

    function toggle(id) {
        const i = reservations.indexOf(id);
        if (i > -1) reservations.splice(i, 1);
        else reservations.push(id);
        localStorage.setItem('res', JSON.stringify(reservations));
        render();
    }

    render();
</script>

          
@inject AppDbContext c
@code
{
    public List<Restaurant> Restaurant { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Restaurant = await c.Restaurants.ToListAsync();

        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            throw;
        }
        await base.OnInitializedAsync();
    }
}
